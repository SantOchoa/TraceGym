# Copia este archivo como .env.local (git lo ignora) y pon tu clave de Google AI Studio.
# OJO: Vite incrusta esta clave en el JavaScript publicado (GitHub Pages),
# así que cualquiera que abra el sitio puede verla. Restríngela a tu dominio en Google Cloud Console.
VITE_GEMINI_API_KEY=

# Opcional: modelo de Gemini (por defecto gemini-4-hydrogen)
VITE_GEMINI_MODEL=
